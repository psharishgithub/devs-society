{
  "name": "devs-portal-backend",
  "version": "1.0.0",
  "description": "Backend API for Devs Society Portal",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dev:watch": "npx nodemon --config nodemon.json",
    "dev:simple": "ts-node --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:setup": "ts-node src/scripts/migrateToSupabase.ts",
    "db:fix": "ts-node src/scripts/fixDatabaseIssues.ts",
    "db:verify": "ts-node src/scripts/verifyDatabaseFix.ts",
    "db:temp": "ts-node src/scripts/temporaryWorkaround.ts",
    "test": "jest"
  },
  "keywords": [
    "devs",
    "portal",
    "backend",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.51.0",
    "@types/qrcode": "^1.5.5",
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.5",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.11.7",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
